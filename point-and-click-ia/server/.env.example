# Copier en .env (jamais commité). Sans .env, tout tourne en mode MOCK, hors ligne.
PORT=8787
HOST=127.0.0.1

# --- Choix des fournisseurs : mock | llm (texte) ; mock | http (image/vision)
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock

# --- LLM compatible OpenAI (ex. API xAI Grok : https://api.x.ai/v1)
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4
# Modèle éventuellement plus rapide pour les dialogues / actions de la roue
LLM_FAST_MODEL=

# --- Génération / retouche d'image (inpainting) et vision (segmentation)
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
VISION_MODEL=

# --- Sauvegarde JSON optionnelle (POST /api/save)
SAVE_DIR=./data/saves
